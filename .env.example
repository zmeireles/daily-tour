# Daily Tour — environment variables
# Copy to `.env` and fill in real values (NEVER commit `.env`).
# All `change-me-please-*` strings are intentional placeholders that match
# the dev-time defaults in `infra/postgres/init/02-roles.sql`. Rotate
# before any non-local deploy (see infra/README.md rotation procedure).

# ─────────────────────────────────────────────────────────────────────────
# Postgres
# ─────────────────────────────────────────────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-please-postgres
POSTGRES_DB=dailytour

# Per-service DB passwords — must match init/02-roles.sql literals exactly.
SERVICE_DB_PASSWORD_CATALOG=change-me-please-catalog
SERVICE_DB_PASSWORD_CHAT=change-me-please-chat
SERVICE_DB_PASSWORD_PLANNER=change-me-please-planner
SERVICE_DB_PASSWORD_SEARCH=change-me-please-search
SERVICE_DB_PASSWORD_INGEST=change-me-please-ingest
SERVICE_DB_PASSWORD_NOTIF=change-me-please-notif
SERVICE_DB_PASSWORD_MEDIA=change-me-please-media
SERVICE_DB_PASSWORD_TOKEN=change-me-please-token
SERVICE_DB_PASSWORD_BFF=change-me-please-bff
SERVICE_DB_PASSWORD_N8N=change-me-please-n8n

# ─────────────────────────────────────────────────────────────────────────
# Redis
# ─────────────────────────────────────────────────────────────────────────
REDIS_PASSWORD=change-me-please-redis

# ─────────────────────────────────────────────────────────────────────────
# RabbitMQ
# ─────────────────────────────────────────────────────────────────────────
RABBITMQ_DEFAULT_USER=dailytour
RABBITMQ_PASSWORD=change-me-please-rabbit

# ─────────────────────────────────────────────────────────────────────────
# MinIO
# ─────────────────────────────────────────────────────────────────────────
MINIO_ROOT_USER=dailytour
MINIO_ROOT_PASSWORD=change-me-please-minio
