# Daily Tour — environment variables
# Copy to `.env` and fill in real values (NEVER commit `.env`).
# All `change-me-please-*` strings are intentional placeholders that match
# the dev-time defaults in `infra/postgres/init/02-roles.sql`. Rotate
# before any non-local deploy (see infra/README.md rotation procedure).

# ─────────────────────────────────────────────────────────────────────────
# Postgres
# ─────────────────────────────────────────────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-please-postgres
POSTGRES_DB=dailytour

# Per-service DB passwords — must match init/02-roles.sql literals exactly.
SERVICE_DB_PASSWORD_CATALOG=change-me-please-catalog
SERVICE_DB_PASSWORD_CHAT=change-me-please-chat
SERVICE_DB_PASSWORD_PLANNER=change-me-please-planner
SERVICE_DB_PASSWORD_SEARCH=change-me-please-search
SERVICE_DB_PASSWORD_INGEST=change-me-please-ingest
SERVICE_DB_PASSWORD_NOTIF=change-me-please-notif
SERVICE_DB_PASSWORD_MEDIA=change-me-please-media
SERVICE_DB_PASSWORD_TOKEN=change-me-please-token
SERVICE_DB_PASSWORD_BFF=change-me-please-bff
SERVICE_DB_PASSWORD_N8N=change-me-please-n8n

# ─────────────────────────────────────────────────────────────────────────
# JWT signing (T-1.0.1 / T-1.0.2)
# ─────────────────────────────────────────────────────────────────────────
# HS256 shared secret — token-svc SIGNS, BFF VERIFIES. Min 32 chars (HS256
# entropy requirement). Rotation: env-var swap + restart on BOTH services
# simultaneously to avoid a brief mismatched window. Phase 5 may move to
# RS256/ES256 + a JWKS endpoint exposed by token-svc for asymmetric verify.
JWT_SIGNING_KEY=change-me-please-jwt-signing-key-must-be-at-least-32-chars-long

# Internal BFF → downstream service URLs (compose-internal hostnames; defaults
# are baked into each service's config.ts so these only need overriding when
# running services outside the default compose stack).
TOKEN_SVC_URL=http://dt_token_svc:8088
CATALOG_SVC_URL=http://dt_catalog_svc:8081

# ─────────────────────────────────────────────────────────────────────────
# PWA → Authentik OIDC authority (T-1.6.1)
# ─────────────────────────────────────────────────────────────────────────
# OIDC authority base URL for the owner-app provider. Must match the
# `authority` in infra/authentik/blueprints/owner-app.yaml.
VITE_AUTHENTIK_URL=https://localhost:9000/application/o/owner-app/

# ─────────────────────────────────────────────────────────────────────────
# BFF → Authentik owner-app JWT verification (T-1.6.0)
# ─────────────────────────────────────────────────────────────────────────
# JWKS endpoint exposed by Authentik for the owner-app OIDC provider. Path
# derives from the application slug in infra/authentik/blueprints/owner-app.yaml;
# rename in lockstep with services/bff/src/config.ts AUTHENTIK_JWKS_URL.
AUTHENTIK_JWKS_URL=http://dt_authentik_server:9000/application/o/owner-app/jwks/
# Required claim value for owner-route access (matches the `staff` group +
# the `groups` scope mapping in owner-app.yaml). Accepted in either `aud`
# or the `groups` array.
AUTHENTIK_OWNER_AUDIENCE=staff

# ─────────────────────────────────────────────────────────────────────────
# Redis
# ─────────────────────────────────────────────────────────────────────────
REDIS_PASSWORD=change-me-please-redis

# ─────────────────────────────────────────────────────────────────────────
# RabbitMQ
# ─────────────────────────────────────────────────────────────────────────
RABBITMQ_DEFAULT_USER=dailytour
RABBITMQ_PASSWORD=change-me-please-rabbit
# AMQP URL consumed by media-svc transcode worker (T-1.4.1).
RABBITMQ_URL=amqp://dailytour:change-me-please-rabbit@dt_rabbitmq:5672/

# ─────────────────────────────────────────────────────────────────────────
# MinIO
# ─────────────────────────────────────────────────────────────────────────
MINIO_ROOT_USER=dailytour
MINIO_ROOT_PASSWORD=change-me-please-minio

# ─────────────────────────────────────────────────────────────────────────
# Media service (T-1.4.0) — media-svc reads these directly; compose maps
# MINIO_ROOT_USER/PASSWORD to MINIO_ACCESS_KEY/SECRET_KEY in the container.
# ─────────────────────────────────────────────────────────────────────────
# 32+ char secret shared between BFF and media-svc. Generate:
#   openssl rand -base64 24
MEDIA_SVC_INTERNAL_TOKEN=change-me-please-media-svc-internal-token-min-32c
# MinIO endpoint as seen from inside the Docker network (override for non-compose setups).
MINIO_ENDPOINT=http://dt_minio:9000
# Service-specific creds (map to MINIO_ROOT_USER/PASSWORD in compose; separate for bare-metal runs).
MINIO_ACCESS_KEY=dailytour
MINIO_SECRET_KEY=change-me-please-minio

# ─────────────────────────────────────────────────────────────────────────
# Embeddings (T-2.0.1) — search-svc worker
# ─────────────────────────────────────────────────────────────────────────
# v1 uses OpenAI text-embedding-3-small (1024 dims). Set EMBEDDING_API_KEY
# to a key with embedding-endpoint access. Phase 2 may swap to Voyage AI
# (Anthropic's recommendation for RAG); switch via EMBEDDING_PROVIDER +
# EMBEDDING_MODEL without changing search-svc code.
# Leave blank in CI — the worker mocks the API in unit tests; integration
# tests assert the worker no-ops without a key (logs + skips upsert).
EMBEDDING_API_KEY=
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1024
# Override only for self-hosted gateways or alternate providers.
EMBEDDING_API_BASE_URL=https://api.openai.com/v1

# ─────────────────────────────────────────────────────────────────────────
# Anthropic Messages API (T-3.0.0) — planner-svc
# ─────────────────────────────────────────────────────────────────────────
# Set ANTHROPIC_API_KEY to a key with Messages-API access. Leave blank in CI
# and local dev — the LLM client warns and short-circuits to None so the
# service still boots (mirrors EMBEDDING_API_KEY's warn-and-skip posture in
# search-svc). Production gates on this being set.
ANTHROPIC_API_KEY=

# ─────────────────────────────────────────────────────────────────────────
# Telegram (T-4.2.0) — chat-hub Telegram driver
# ─────────────────────────────────────────────────────────────────────────
# Bot token from @BotFather. Leave blank in dev/CI — chat-hub warns and
# short-circuits sends (no crashes). Required for production webhook delivery.
TELEGRAM_BOT_TOKEN=
# Arbitrary secret (up to 256 chars, A-Za-z0-9_-). Set in the Telegram
# setWebhook call as `secret_token`; chat-hub rejects payloads that omit it.
# Generate: openssl rand -hex 32
TELEGRAM_WEBHOOK_SECRET=

# ─────────────────────────────────────────────────────────────────────────
# WhatsApp Business API (T-5.6.0) — chat-hub WhatsApp driver
# ─────────────────────────────────────────────────────────────────────────
# Phone Number ID from Meta developer console. Leave blank in dev/CI —
# chat-hub falls back to wa.me deep-links and warns (no crashes).
WHATSAPP_PHONE_NUMBER_ID=
# Permanent access token (System User) or temporary page token. Required
# alongside WHATSAPP_PHONE_NUMBER_ID for Cloud API sends.
WHATSAPP_ACCESS_TOKEN=
# Arbitrary string returned to Meta during webhook registration (GET challenge).
# Must match the verify token set in the Meta App Dashboard webhook config.
# Generate: openssl rand -hex 16
WHATSAPP_VERIFY_TOKEN=
# App Secret from Meta App Dashboard — used to verify X-Hub-Signature-256 on
# inbound webhook POSTs. Leave blank to skip HMAC verification (dev only).
WHATSAPP_APP_SECRET=

# ─────────────────────────────────────────────────────────────────────────
# Traefik
# ─────────────────────────────────────────────────────────────────────────
TRAEFIK_DASHBOARD_PASSWORD=change-me-please-traefik-dashboard
TRAEFIK_ACME_EMAIL=ops@example.local
# Base domain for Traefik Host() rules. dt.localhost keeps daily-tour's hostnames
# distinct from sibling dev stacks (cc-dev, po-platform, fit, supabase) and any
# other future *.localhost project. Override to your real domain in Phase 5.
TRAEFIK_DOMAIN_BASE=dt.localhost

# ─────────────────────────────────────────────────────────────────────────
# Host port allocations — daily-tour reserves the 27xxx block to avoid host
# port collisions with sibling dev stacks (cc-dev on 5432/6379/9000/9001/80/
# 443/8080, po-platform on 5432/9000/9001/80/443/8080, fit on 35432/38080,
# supabase on 5432/6543/8000/8443). Override any of these to relocate.
# Container-internal ports stay on the standard values.
# ─────────────────────────────────────────────────────────────────────────
DT_HOST_PORT_POSTGRES=27432
DT_HOST_PORT_REDIS=27379
DT_HOST_PORT_RABBITMQ_AMQP=27672
DT_HOST_PORT_RABBITMQ_MGMT=27673
DT_HOST_PORT_MINIO_API=27900
DT_HOST_PORT_MINIO_CONSOLE=27901
DT_HOST_PORT_TRAEFIK_HTTP=27080
DT_HOST_PORT_TRAEFIK_HTTPS=27443
DT_HOST_PORT_TRAEFIK_DASHBOARD=27088
# bff host port — exposed so the PWA dev server (vite) can proxy /r/ + /v1/
# fetches without needing Traefik. Production routes through Traefik instead.
DT_HOST_PORT_BFF=28080

# ─────────────────────────────────────────────────────────────────────────
# Authentik (T-0.3.2)
# ─────────────────────────────────────────────────────────────────────────
# 50+ char secret. Generate: openssl rand -base64 60
AUTHENTIK_SECRET_KEY=change-me-please-authentik-secret-key-must-be-at-least-50-chars-long
AUTHENTIK_PG_PASSWORD=change-me-please-authentik-pg
AUTHENTIK_BOOTSTRAP_PASSWORD=change-me-please-authentik-admin
AUTHENTIK_BOOTSTRAP_TOKEN=change-me-please-authentik-bootstrap-token
AUTHENTIK_BOOTSTRAP_EMAIL=admin@example.local
# Per-application OIDC client secrets (one per app via blueprint)
AUTHENTIK_OWNER_APP_CLIENT_SECRET=change-me-please-owner-app-client-secret

# ─────────────────────────────────────────────────────────────────────────
# n8n (T-0.3.3) — auth via n8n's built-in User Management.
# First boot serves the owner-setup wizard at http://n8n.dt.localhost:27080/setup;
# the first user becomes the instance owner. N8N_BASIC_AUTH_* was removed
# upstream in v0.184. Authentik forward-auth integration is deferred to
# T-0.3.4 / T-1.6.x once the Authentik Proxy Provider is wired to the
# embedded outpost.
# ─────────────────────────────────────────────────────────────────────────
# 32+ chars — encrypts n8n's stored workflow credentials. Generate:
#   openssl rand -hex 24
N8N_ENCRYPTION_KEY=change-me-please-n8n-encryption-key-32chars-or-more

# ─────────────────────────────────────────────────────────────────────────
# notif-svc (T-5.5.0) — post-stay email dispatch
# ─────────────────────────────────────────────────────────────────────────
# SMTP connection URL. Schemes:
#   smtp://user:pass@host:port  — plain / STARTTLS auto-upgrade
#   smtps://user:pass@host:465  — implicit TLS
#   smtp+starttls://...         — force STARTTLS (port 587)
# Dev default points at MailHog (docker-compose.base.yml) on port 1025.
SMTP_URL=smtp://localhost:1025
SMTP_FROM=no-reply@daily-tour.example.local
# Used by n8n post-stay-review workflow to reach notif-svc inside the stack.
NOTIF_SVC_URL=http://dt_notif_svc:8085
