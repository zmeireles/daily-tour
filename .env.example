# Daily Tour — environment variables
# Copy to `.env` and fill in real values (NEVER commit `.env`).
# All `change-me-please-*` strings are intentional placeholders that match
# the dev-time defaults in `infra/postgres/init/02-roles.sql`. Rotate
# before any non-local deploy (see infra/README.md rotation procedure).

# ─────────────────────────────────────────────────────────────────────────
# Postgres
# ─────────────────────────────────────────────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-please-postgres
POSTGRES_DB=dailytour

# Per-service DB passwords — must match init/02-roles.sql literals exactly.
SERVICE_DB_PASSWORD_CATALOG=change-me-please-catalog
SERVICE_DB_PASSWORD_CHAT=change-me-please-chat
SERVICE_DB_PASSWORD_PLANNER=change-me-please-planner
SERVICE_DB_PASSWORD_SEARCH=change-me-please-search
SERVICE_DB_PASSWORD_INGEST=change-me-please-ingest
SERVICE_DB_PASSWORD_NOTIF=change-me-please-notif
SERVICE_DB_PASSWORD_MEDIA=change-me-please-media
SERVICE_DB_PASSWORD_TOKEN=change-me-please-token
SERVICE_DB_PASSWORD_BFF=change-me-please-bff
SERVICE_DB_PASSWORD_N8N=change-me-please-n8n

# ─────────────────────────────────────────────────────────────────────────
# Redis
# ─────────────────────────────────────────────────────────────────────────
REDIS_PASSWORD=change-me-please-redis

# ─────────────────────────────────────────────────────────────────────────
# RabbitMQ
# ─────────────────────────────────────────────────────────────────────────
RABBITMQ_DEFAULT_USER=dailytour
RABBITMQ_PASSWORD=change-me-please-rabbit

# ─────────────────────────────────────────────────────────────────────────
# MinIO
# ─────────────────────────────────────────────────────────────────────────
MINIO_ROOT_USER=dailytour
MINIO_ROOT_PASSWORD=change-me-please-minio

# ─────────────────────────────────────────────────────────────────────────
# Traefik
# ─────────────────────────────────────────────────────────────────────────
TRAEFIK_DASHBOARD_PASSWORD=change-me-please-traefik-dashboard
TRAEFIK_ACME_EMAIL=ops@example.local
TRAEFIK_DOMAIN_BASE=localhost

# ─────────────────────────────────────────────────────────────────────────
# Authentik (T-0.3.2)
# ─────────────────────────────────────────────────────────────────────────
# 50+ char secret. Generate: openssl rand -base64 60
AUTHENTIK_SECRET_KEY=change-me-please-authentik-secret-key-must-be-at-least-50-chars-long
AUTHENTIK_PG_PASSWORD=change-me-please-authentik-pg
AUTHENTIK_BOOTSTRAP_PASSWORD=change-me-please-authentik-admin
AUTHENTIK_BOOTSTRAP_TOKEN=change-me-please-authentik-bootstrap-token
AUTHENTIK_BOOTSTRAP_EMAIL=admin@example.local
# Per-application OIDC client secrets (one per app via blueprint)
AUTHENTIK_OWNER_APP_CLIENT_SECRET=change-me-please-owner-app-client-secret

# ─────────────────────────────────────────────────────────────────────────
# n8n (T-0.3.3) — basic auth in dev; Authentik forward-auth deferred to a
# follow-up task (T-0.3.4 or T-1.6.x) once Authentik's Proxy Provider is
# wired to the embedded outpost.
# ─────────────────────────────────────────────────────────────────────────
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=change-me-please-n8n-basic-auth
# 32+ chars — encrypts stored credentials. Generate: openssl rand -hex 24
N8N_ENCRYPTION_KEY=change-me-please-n8n-encryption-key-32chars-or-more
