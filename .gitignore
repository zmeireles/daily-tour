# Claude Code
.claude/
temp/
.mcp.json

# Node / Turborepo
node_modules/
.turbo/

# Environment files (keep .env.example and .env*.example committed)
.env
.env.*
!.env.example
!.env*.example

# Build outputs
dist/
build/
coverage/

# Logs
*.log

# Caches
.cache/

# OS files
.DS_Store
Thumbs.db

# cs-agent housekeeping marker
.cs-agent-autocommitted

# Lefthook local overrides (never commit; .lefthook-local.example.yml IS committed)
lefthook-local.yml
.lefthook-local.yml

# Traefik ACME storage — permissions must be 600; never commit
infra/traefik/acme/acme.json

# Generated qual Postgres init dir — holds rotated DB-role passwords; never commit.
# Only scripts/qual/gen-env-qual.sh writes it (on the VPS at deploy time).
infra/postgres/init-qual/

# Deploy-rendered Alertmanager config — holds the Telegram bot token; never
# commit. Rendered from alertmanager.yml.tmpl by deploy-qa.yml on the VPS.
infra/observability/alertmanager.yml

# Qual deploy state on the VPS clone (written by deploy-qa.yml; survives the
# git-checkout sync because untracked). Never committed.
.last_deploy_tag
.deploy-history.md

# Local environment files renamed to dodge the .env bash-secret-guard hook.
# Same intent as .env above: never committed.
dev-environment
dev-environment.*

# tsup's transient bundled config. bundle-require writes it beside the real
# config during a build and unlinks it on the normal path — but a killed build
# (the OOM/contention class behind #393) leaves it on disk. eslint now ignores
# it (#395), so nothing would flag a stray one; without this, autocommit could
# quietly commit it.
tsup.config.bundled_*
