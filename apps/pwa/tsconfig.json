{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "@daily-tour/shared-config/tsconfig/react",
  "include": ["src/**/*"],
  "exclude": ["dist", "node_modules", "e2e", "src/**/__tests__/**"],
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"]
    },
    "types": ["vite/client", "vite-plugin-pwa/client"]
  }
}
