# Alertmanager config TEMPLATE — Daily Tour qual (T-3.A.2)
#
# NOT mounted directly. deploy-qa.yml renders this to
# infra/observability/alertmanager.yml (gitignored) at deploy time via
# `envsubst '${ALERT_TELEGRAM_BOT_TOKEN} ${ALERT_TELEGRAM_CHAT_ID}'`, which
# substitutes ONLY those two vars and leaves the Go `{{ }}` template tokens
# untouched. The rendered file is what the alertmanager container mounts.
route:
  receiver: telegram
  group_by: ['alertname', 'service_name', 'instance']
  group_wait: 30s
  group_interval: 5m
  repeat_interval: 4h
receivers:
  - name: telegram
    telegram_configs:
      - bot_token: '${ALERT_TELEGRAM_BOT_TOKEN}'
        chat_id: ${ALERT_TELEGRAM_CHAT_ID}
        send_resolved: true
        parse_mode: HTML
        # Block scalar so the line breaks are REAL newlines. A single-quoted
        # YAML string keeps `\n` literal, which both shows as "\n" and gets
        # appended to the trailing URL (→ a 404 link). Keep the summary URL at
        # the end of the message so Telegram auto-links it cleanly.
        message: |-
          {{ if eq .Status "firing" }}🔴{{ else }}✅{{ end }} <b>{{ .CommonLabels.alertname }}</b> ({{ .Status }})
          {{ range .Alerts }}{{ .Annotations.summary }}{{ end }}
