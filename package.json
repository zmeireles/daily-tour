{
  "name": "daily-tour",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22 <23",
    "pnpm": ">=9"
  },
  "packageManager": "pnpm@9.14.2",
  "pnpm": {
    "overrides": {
      "shell-quote": ">=1.9.0",
      "@grpc/grpc-js": ">=1.14.4",
      "ws": ">=8.21.0",
      "protobufjs": ">=7.6.3 <8",
      "vite": ">=6.4.3 <7",
      "fast-uri": ">=3.1.5 <4",
      "find-my-way": ">=9.7.0 <10",
      "postcss": ">=8.5.18 <9",
      "@opentelemetry/propagator-jaeger": ">=2.9.0 <3"
    }
  },
  "scripts": {
    "dev": "turbo run dev --concurrency=10",
    "build": "turbo run build",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "clean": "turbo run clean && rm -rf node_modules",
    "prepare": "lefthook install || true"
  },
  "devDependencies": {
    "lefthook": "^1.10.0",
    "turbo": "^2.9.12",
    "typescript": "^5.6.3"
  }
}
