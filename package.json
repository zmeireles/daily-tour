{
  "name": "daily-tour",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22 <23",
    "pnpm": ">=9"
  },
  "packageManager": "pnpm@9.14.2",
  "pnpm": {
    "overrides": {
      "shell-quote": ">=1.8.4",
      "@grpc/grpc-js": ">=1.14.4",
      "ws": ">=8.21.0",
      "protobufjs": ">=7.6.3 <8",
      "vite": ">=6.4.3 <7"
    }
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "clean": "turbo run clean && rm -rf node_modules",
    "prepare": "lefthook install || true"
  },
  "devDependencies": {
    "lefthook": "^1.10.0",
    "turbo": "^2.3.3",
    "typescript": "^5.6.3"
  }
}
