{
  "name": "@daily-tour/shared-sentry",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "clean": "rm -rf dist .turbo"
  },
  "dependencies": {
    "@sentry/node": "^10.0.0"
  },
  "devDependencies": {
    "@daily-tour/shared-config": "workspace:*",
    "@types/node": "^22.0.0",
    "fastify": "^5.8.5",
    "tsup": "^8.0.0",
    "typescript": "^5.6.3",
    "vitest": "^3.2.7"
  }
}
