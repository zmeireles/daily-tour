{
  "name": "@daily-tour/media-svc",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "files": [
    "dist",
    "drizzle/migrations"
  ],
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsup",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:check": "drizzle-kit check",
    "db:up": "drizzle-kit up",
    "db:migrate": "tsx src/migrate.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "clean": "rm -rf dist node_modules .turbo coverage"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.787.0",
    "@aws-sdk/s3-request-presigner": "^3.787.0",
    "@daily-tour/shared-otel": "workspace:*",
    "@daily-tour/shared-sentry": "workspace:*",
    "@daily-tour/shared-types": "workspace:*",
    "@fastify/cors": "^11.0.0",
    "@fastify/helmet": "^13.0.0",
    "@fastify/rate-limit": "^10.0.0",
    "amqplib": "^2.0.1",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.8.5",
    "fastify-plugin": "^5.0.0",
    "pg": "^8.13.0",
    "sharp": "^0.35.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@daily-tour/shared-config": "workspace:*",
    "@testcontainers/postgresql": "^10.16.0",
    "@types/amqplib": "^0.10.8",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.11.0",
    "drizzle-kit": "^0.31.10",
    "testcontainers": "^10.16.0",
    "tsup": "^8.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.3",
    "vitest": "^2.1.0"
  }
}
