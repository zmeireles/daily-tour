{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2023"],
    "types": ["node"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "allowJs": true,
    "baseUrl": "."
  },
  "include": [
    "src/**/*",
    "test/**/*",
    "eslint.config.js",
    "drizzle.config.ts",
    "tsup.config.ts",
    "vitest.config.ts"
  ]
}
